NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

NEXT_PUBLIC_SUPABASE_URL=https://...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ValueSerp API Key for real-time Google Shopping data
VALUESERP_API_KEY=your_valueserp_api_key_here

# Optional AI search and deal insights
GEMINI_API_KEY=your_gemini_api_key_here

# Optional shared caching and rate limiting (both required to use Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional hosted Chromium CDP WebSocket endpoint; otherwise Vercel uses bundled serverless Chromium.
# Keep private: may contain the browser service's token. Never use NEXT_PUBLIC_.
QUICK_COMMERCE_BROWSER_WS_ENDPOINT=

# Optional QuickCommerceAPI trial. Server only; uses credits for location-based searches.
QUICK_COMMERCE_API_KEY=

# Optional local Chrome/Chromium executable path. Without it, the local Chrome channel is used.
# Vercel uses the matching Linux serverless Chromium package automatically.
PUPPETEER_EXECUTABLE_PATH=
